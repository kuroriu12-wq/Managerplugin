{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AbsentMotion plugin recipe (host API 1)",
  "type": "object",
  "required": ["id", "name", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "\\S" },
    "name": { "type": "string", "pattern": "\\S" },
    "description": { "type": "string", "maxLength": 200, "description": "Shown under the recipe name in the tool list." },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "scalar": { "type": ["string", "number", "boolean"] },
    "input": {
      "type": "object",
      "required": ["id", "label", "type", "default"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "label": { "type": "string", "pattern": "\\S" },
        "type": { "enum": ["number", "color", "choice", "text", "switch"] },
        "default": { "$ref": "#/$defs/scalar" },
        "options": { "type": "array", "items": { "type": "string" } },
        "min": { "type": "number" },
        "max": { "type": "number" }
      },
      "if": { "properties": { "type": { "const": "choice" } }, "required": ["type"] },
      "then": { "required": ["options"], "properties": { "options": { "minItems": 1 } } }
    },
    "step": {
      "type": "object",
      "required": ["do"],
      "oneOf": [
        {
          "properties": {
            "do": { "const": "addEffect" },
            "effect": { "type": "string", "pattern": "\\S" },
            "preset": { "type": "string" },
            "set": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } }
          },
          "required": ["do", "effect"]
        },
        {
          "properties": {
            "do": { "const": "setEffectParam" },
            "effect": { "type": "string", "pattern": "\\S" },
            "param": { "type": "string", "pattern": "\\S" },
            "value": { "$ref": "#/$defs/scalar" }
          },
          "required": ["do", "effect", "param", "value"]
        },
        {
          "properties": {
            "do": { "const": "keyframeEffectParam" },
            "effect": { "type": "string", "pattern": "\\S" },
            "param": { "type": "string", "pattern": "\\S" },
            "at": { "type": "array", "minItems": 1, "items": { "type": "number" } },
            "values": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scalar" } }
          },
          "required": ["do", "effect", "param", "at", "values"]
        }
      ]
    }
  }
}
